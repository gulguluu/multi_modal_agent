FROM intel/intel-extension-for-pytorch:2.7.10-serving-xpu

WORKDIR /app

# Set environment variables for Intel XPU optimization
ENV IPEX_OPTIMIZE=1 \
    IPEX_MERGE_FUSION=1 \
    IPEX_AUTO_TUNE=1 \
    IPEX_VERBOSE=1 \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_HOME=/app/.cache/huggingface \
    HF_HUB_CACHE=/app/.cache/huggingface

RUN mkdir -p /app/.cache/huggingface && \
    chmod -R 777 /app/.cache

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN pip install --no-cache-dir einops diffusers accelerate "pyvips[binary]"
RUN python3 -c "from transformers import AutoModelForCausalLM; AutoModelForCausalLM.from_pretrained('vikhyatk/moondream2', trust_remote_code=True)"

COPY main.py /app/
RUN mkdir -p /app/data

ENTRYPOINT ["python", "/app/main.py"]
